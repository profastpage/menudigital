# ──────────────────────────────────────────────────────────────
# MenuPro — Variables de entorno
# Copia este archivo a `.env.local` y completa con tus valores
# ──────────────────────────────────────────────────────────────

# Supabase (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx

# MercadoPago (https://www.mercadopago.com/developers/panel/app)
# - Access Token: APP_USR-xxxxx (producción) o TEST-xxxxx (sandbox)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxx
MERCADOPAGO_SANDBOX=false
# Moneda ISO 4217: PEN, MXN, COP, CLP, ARS, BRL, USD...
MERCADOPAGO_CURRENCY_ID=PEN

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Prisma (solo local — Vercel usará Postgres de Supabase)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ──────────────────────────────────────────────────────────────
# Solo para scripts/sync-vercel-env.js (sincronizar Supabase → Vercel)
# NO subir a producción — solo se usan localmente para correr el script
# ──────────────────────────────────────────────────────────────
# SUPABASE_PROJECT_REF=bkxtploibraiovgrjtwn
# SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxx        # https://supabase.com/dashboard/account/tokens
# VERCEL_TOKEN=vercel_xxxxxxxxxxxx              # https://vercel.com/account/tokens
# VERCEL_PROJECT_ID=prj_xxxxxxxxxxxx            # Vercel → Settings → General
