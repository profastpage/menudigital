# =============================================================
# MenuPro SaaS — Variables de entorno
# Copia este archivo a .env.local y completa con tus valores
# =============================================================
#
# PASO 1: Supabase
#   1. Crea un proyecto en https://supabase.com/dashboard
#   2. Ve a Settings → API y copia:
#      - Project URL → NEXT_PUBLIC_SUPABASE_URL
#      - Anon/Public key → NEXT_PUBLIC_SUPABASE_ANON_KEY
#   3. Ejecuta supabase/schema.sql en Supabase:
#      - Ve al SQL Editor (ícono de base de datos en barra lateral)
#      - Haz clic en "New query"
#      - COPIA Y PEGA el CONTENIDO del archivo schema.sql (no su nombre)
#      - Haz clic en "Run"
#   4. Configura Google en Supabase:
#      - Authentication → Providers → Google → habilitar
#      - Client ID y Client Secret de Google Cloud Console
#
# PASO 2: Google Cloud Console (CRÍTICO para OAuth)
#   1. Ve a https://console.cloud.google.com/
#   2. Crea un proyecto o selecciona el existente
#   3. Ve a APIs & Services → Credentials
#   4. Crea un "OAuth 2.0 Client ID" (tipo Web application)
#   5. En "Authorized redirect URIs" AGREGA EXACTAMENTE:
#      https://menudigital-pro.vercel.app/auth/callback
#   6. En "Authorized JavaScript origins" AGREGA:
#      https://menudigital-pro.vercel.app
#   7. Guarda y espera unos minutos para que se propague
#
# PASO 3: Supabase Authentication Config
#   1. En Supabase → Authentication → URL Configuration:
#      - Site URL: https://menudigital-pro.vercel.app
#      - Redirect URLs: https://menudigital-pro.vercel.app/auth/callback
#
# PASO 4: Deploy
#   - Puedes deployar en cualquier hosting: Vercel, Railway, Fly.io, VPS...
#   - NEXT_PUBLIC_SITE_URL debe ser la URL final (sin / al final)
#
# PASO 5: Super Admin (después de registrarte)
#   1. Regístrate en tu app y crea tu cuenta
#   2. En Supabase SQL Editor ejecuta:
#      UPDATE profiles SET is_super_admin = true WHERE email = 'tu-email@gmail.com';
#   3. Recarga tu dashboard — verás el enlace "Super Admin" en el sidebar
#
# =============================================================

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJTU_ANON_KEY_AQUI

# ── URL del sitio (CRÍTICO para Google OAuth) ──
# Esta URL debe coincidir EXACTAMENTE con:
#   1. La URL donde se despliega la app
#   2. La "Site URL" en Supabase → Authentication → URL Configuration
#   3. El "Authorized redirect URI" en Google Cloud Console
NEXT_PUBLIC_SITE_URL=https://menudigital-pro.vercel.app

# ── MercadoPago ──
MERCADOPAGO_ACCESS_TOKEN=TEST-TU_ACCESS_TOKEN
MERCADOPAGO_SANDBOX=true
MERCADOPAGO_CURRENCY_ID=PEN
