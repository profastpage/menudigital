# =============================================================
# MenuPro SaaS — Variables de entorno
# Copia este archivo a .env.local y completa con tus valores
# =============================================================
#
# PASO 1: Supabase
#   1. Crea un proyecto en https://supabase.com/dashboard
#   2. Ve a Settings → API y copia:
#      - Project URL → NEXT_PUBLIC_SUPABASE_URL
#      - Anon/Public key → NEXT_PUBLIC_SUPABASE_ANON_KEY
#   3. Ve a Authentication → Providers → Google:
#      - Habilita Google OAuth
#      - Client ID y Client Secret de Google Cloud Console
#      - Authorized redirect URI: TU_SITE_URL/auth/callback
#   4. Ejecuta supabase/schema.sql en el SQL Editor de Supabase
#
# PASO 2: Deploy (NO Vercel obligatorio)
#   - Puedes deployar en cualquier hosting: Railway, Fly.io, VPS, Docker...
#   - NEXT_PUBLIC_SITE_URL debe ser la URL final de tu app (sin trailing slash)
#
# =============================================================

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJTU_ANON_KEY_AQUI

# ── URL del sitio (CRÍTICO para Google OAuth) ──
# Esta URL debe coincidir con:
#   1. La URL donde se despliega la app
#   2. La "Site URL" en Supabase Dashboard → Authentication → URL Configuration
#   3. El "Authorized redirect URI" en Google Cloud Console
NEXT_PUBLIC_SITE_URL=https://menudigital-pro.vercel.app

# ── MercadoPago ──
MERCADOPAGO_ACCESS_TOKEN=TEST-TU_ACCESS_TOKEN
MERCADOPAGO_SANDBOX=true
MERCADOPAGO_CURRENCY_ID=PEN

# ── Base de datos local (solo para dev sin Supabase) ──
DATABASE_URL=file:/home/z/my-project/db/custom.db
